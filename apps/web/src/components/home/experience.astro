---
import { experience, formatPeriod } from '@/data/experience'
---

<section
  id="experience"
  class="w-full px-4 sm:px-6 md:px-8 lg:px-12 mx-auto max-w-7xl pt-16 scroll-mt-20"
>
  <h2 class="text-2xl font-bold mb-8">Experience</h2>
  <ol class="space-y-8 border-l border-border pl-6">
    {experience.map((entry) => (
      <li class="relative">
        <span class="absolute -left-[1.85rem] top-2 h-2.5 w-2.5 rounded-full bg-primary"></span>
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="text-lg font-semibold">
            {entry.role} · {entry.company}
          </h3>
          <p class="text-sm text-muted-foreground">
            <time datetime={entry.start}>{formatPeriod(entry)}</time>{entry.type && ` · ${entry.type}`}
          </p>
        </div>
        {entry.summary && <p class="mt-1 text-sm text-muted-foreground">{entry.summary}</p>}
        {entry.highlights && entry.highlights.length > 0 && (
          <ul class="mt-2 list-disc pl-5 space-y-1 text-sm">
            {entry.highlights.map((item) => <li>{item}</li>)}
          </ul>
        )}
        {entry.link && (
          <a
            href={entry.link.href}
            class="mt-2 inline-block text-sm underline underline-offset-4 hover:text-primary transition-colors"
          >
            {entry.link.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</section>
