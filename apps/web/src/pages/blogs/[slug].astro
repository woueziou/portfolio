---
import { ArrowLeft, Calendar, Clock } from 'lucide-react'
import ArticleRenderer from '@/components/projects/ArticleRenderer.astro'
export const prerender = false

import BaseLayout from '@/layouts/BaseLayout.astro'
import { createSupabaseServerClient } from '@/lib/supabase/server'
import { withTimeout } from '@/lib/supabase/with-timeout'
import { renderTiptapToHtml } from '@/lib/html-renderer'
import { formatDate } from '@/utils/formater'

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/404')
}

const supabase = createSupabaseServerClient(Astro.cookies)

const [{ data: profile }, { data: article, error: articleError }] = await Promise.all([
  withTimeout(
    supabase.from('profiles').select('first_name, last_name').limit(1).single(),
    8000,
    { data: null, error: { message: 'Profile query timed out' } } as any,
  ),
  withTimeout(
    supabase
      .from('articles')
      .select('id, title, slug, summary, content, published_at, created_at, reading_time_minutes, image_url, status')
      .eq('slug', slug)
      .eq('status', 'published')
      .single(),
    8000,
    { data: null, error: { message: 'Article query timed out' } } as any,
  ),
])

const authorName = profile ? `${profile.first_name} ${profile.last_name}` : 'Taas S. Ekpaye'

if (articleError || !article) {
  return Astro.redirect('/404')
}

const contentHtml = article.content ? renderTiptapToHtml(article.content as any) : ''
const wordCount = contentHtml ? contentHtml.split(/\s+/).length : undefined

const pageTitle = `${article.title} — ${authorName}`
const pageDescription = article.summary?.slice(0, 160) ?? article.title
const ogImage = article.image_url ?? undefined

const jsonLdArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary,
  datePublished: article.published_at || article.created_at,
  author: { '@type': 'Person', name: authorName },
  wordCount,
  timeRequired: article.reading_time_minutes ? `PT${article.reading_time_minutes}M` : undefined,
}
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <div class="antialiased bg-noise font-baufra min-h-screen">
    <nav class="sticky top-0 z-40 bg-background/80 backdrop-blur-md border-b border-border">
      <div class="container mx-auto px-4 py-3 flex items-center">
        <a href="/blogs" class="flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
          <ArrowLeft class="h-4 w-4" />
          Back to Blogs
        </a>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-12 max-w-3xl">
      <header class="mb-10">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">{article.title}</h1>
        <div class="flex items-center gap-4 text-sm text-muted-foreground">
          {article.published_at && (
            <span class="flex items-center gap-1.5">
              <Calendar class="h-4 w-4" />
              {formatDate(article.published_at, 'MMMM D, YYYY')}
            </span>
          )}
          {article.reading_time_minutes && (
            <span class="flex items-center gap-1.5">
              <Clock class="h-4 w-4" />
              {article.reading_time_minutes} min read
            </span>
          )}
        </div>
        {article.summary && (
          <p class="text-lg text-muted-foreground leading-relaxed mt-6">{article.summary}</p>
        )}
      </header>

      {contentHtml && <ArticleRenderer contentHtml={contentHtml} />}
    </main>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
</BaseLayout>
