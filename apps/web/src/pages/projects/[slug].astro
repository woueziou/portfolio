---
import type { Database } from '@portfolio/shared'
import { ArrowLeft, Calendar, Clock, ExternalLink } from 'lucide-react'
import ArticleRenderer from '@/components/projects/ArticleRenderer.astro'
export const prerender = false

import BaseLayout from '@/layouts/BaseLayout.astro'
import { createSupabaseServerClient } from '@/lib/supabase/server'
import { withTimeout } from '@/lib/supabase/with-timeout'
import { renderTiptapToHtml } from '@/lib/html-renderer'
import { formatDate } from '@/utils/formater'

type Project = Database['public']['Tables']['projects']['Row']
interface TechstackInfo {
  id: string
  name: string
  icon: string
}
type Article = Database['public']['Tables']['articles']['Row']

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/404')
}

const supabase = createSupabaseServerClient(Astro.cookies)

const [{ data: profile }, { data: project, error: projectError }] = await Promise.all([
  withTimeout(
    supabase.from('profiles').select('first_name, last_name').limit(1).single(),
    8000,
    { data: null, error: { message: 'Profile query timed out' } } as any,
  ),
  withTimeout(
    supabase
      .from('projects')
      .select(`
        title, description, main_image_url, url, access_link, state, project_date, type, tech_stack, slug, publication_status, id, published_at,
      project_techstacks(
        techstack_id,
        techstacks(id, name, icon)
      )`)
      .eq('slug', slug)
      .eq('publication_status', 'published')
      .single(),
    8000,
    { data: null, error: { message: 'Project query timed out' } } as any,
  ),
])

const authorName = profile ? `${profile.first_name} ${profile.last_name}` : 'Taas S. Ekpaye'

if (projectError || !project) {
  return Astro.redirect('/404')
}

const typedProject = project as Project & {
  project_techstacks?: Array<{
    techstack_id: string
    techstacks: TechstackInfo | null
  }>
}

const projectId = typedProject.id

const techstacksFromRelation: TechstackInfo[] =
  typedProject.project_techstacks
    ?.filter((pt) => pt.techstacks)
    .map((pt) => pt.techstacks as TechstackInfo) || []

const legacyTechs = (typedProject.tech_stack || []).filter(
  (t: string) => !techstacksFromRelation.some((r) => r.name.toLowerCase() === t.toLowerCase()),
)

const { data: articles } = await withTimeout(
  supabase
    .from('articles')
    .select('id, title, slug, content, published_at, created_at, reading_time_minutes, status')
    .eq('project_id', projectId)
    .eq('status', 'published')
    .order('published_at', { ascending: false }),
  8000,
  { data: null, error: { message: 'Articles query timed out' } } as any,
)

const typedArticles = (articles || []) as Article[]

// Convert TipTap JSON content to HTML for each article
const articleContentHtml = new Map<number, string>()
for (const a of typedArticles) {
  if (a.content) {
    const html = renderTiptapToHtml(a.content as any)
    if (html) articleContentHtml.set(a.id, html)
  }
}

const projectTitle = typedProject.title ?? 'Untitled Project'
const pageTitle = `${projectTitle} — ${authorName}`
const pageDescription = typedProject.description?.slice(0, 160) ?? projectTitle
const ogImage = typedProject.main_image_url === null ? undefined : typedProject.main_image_url

const jsonLdProject = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: projectTitle,
  description: typedProject.description ?? '',
  url: typedProject.url || undefined,
  applicationCategory: 'WebApplication',
  datePublished: typedProject.published_at || undefined,
  author: { '@type': 'Person', name: authorName },
}
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={ogImage}>
  <div class="antialiased bg-noise font-baufra min-h-screen">
    <nav class="sticky top-0 z-40 bg-background/80 backdrop-blur-md border-b border-border">
      <div class="container mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
          <ArrowLeft class="h-4 w-4" />
          Back to Portfolio
        </a>
        {typedProject.url && (
          <a href={typedProject.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-sm font-medium text-primary hover:underline underline-offset-4">
            View Live
            <ExternalLink class="h-3.5 w-3.5" />
          </a>
        )}
      </div>
    </nav>

    <main class="container mx-auto px-4 py-12 max-w-4xl">
      <header class="mb-12">
        {typedProject.main_image_url && (
          <div class="mb-8 rounded-xl overflow-hidden shadow-lg">
            <img src={typedProject.main_image_url} alt={typedProject.title} class="w-full h-auto object-cover" loading="eager" />
          </div>
        )}
        <div class="flex flex-wrap items-center gap-3 mb-4 text-sm text-muted-foreground">
          {typedProject.project_date && (
            <span class="flex items-center gap-1.5">
              <Calendar class="h-4 w-4" />
              {formatDate(typedProject.project_date, 'MMMM YYYY')}
            </span>
          )}
          <span class="flex items-center gap-1.5 capitalize">{typedProject.state}</span>
          {typedProject.type.map((t) => (
            <span class="px-2 py-0.5 bg-secondary/30 rounded text-xs font-medium capitalize">{t}</span>
          ))}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">{projectTitle}</h1>
        <p class="text-lg text-muted-foreground leading-relaxed mb-6">{typedProject.description}</p>
        <div class="flex flex-wrap gap-2">
          {techstacksFromRelation.map((ts) => (
            <span class="flex items-center gap-1.5 px-3 py-1.5 border border-secondary/30 text-sm hover:bg-primary hover:text-white transition-colors">{ts.name}</span>
          ))}
          {legacyTechs.map((tech) => (
            <span class="flex items-center gap-1.5 px-3 py-1.5 border border-secondary/30 text-sm hover:bg-primary hover:text-white transition-colors">{tech}</span>
          ))}
        </div>
        {typedProject.access_link && (
          <div class="mt-6">
            <a href={typedProject.access_link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-lg hover:opacity-90 transition-opacity font-medium">
              Access Project
              <ExternalLink class="h-4 w-4" />
            </a>
          </div>
        )}
      </header>

      {typedArticles.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-bold mb-8 border-b border-border pb-4">Articles</h2>
          <div class="space-y-16">
            {typedArticles.map((article) => (
              <article class="group">
                <div class="mb-6">
                  <h3 class="text-2xl font-bold mb-2 group-hover:text-primary transition-colors">{article.title}</h3>
                  <div class="flex items-center gap-4 text-sm text-muted-foreground">
                    {article.published_at && (
                      <span class="flex items-center gap-1.5">
                        <Calendar class="h-3.5 w-3.5" />
                        {formatDate(article.published_at, 'MMMM D, YYYY')}
                      </span>
                    )}
                    {article.reading_time_minutes && (
                      <span class="flex items-center gap-1.5">
                        <Clock class="h-3.5 w-3.5" />
                        {article.reading_time_minutes} min read
                      </span>
                    )}
                  </div>
                </div>
                {(() => { const h = articleContentHtml.get(article.id); return h ? <ArticleRenderer contentHtml={h} /> : null })()}
              </article>
            ))}
          </div>
        </section>
      )}
    </main>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdProject)} />
    {typedArticles.map((article) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: article.title,
        datePublished: article.published_at || article.created_at,
        author: { '@type': 'Person', name: authorName },
        isPartOf: { '@type': 'SoftwareApplication', name: projectTitle },
        wordCount: (articleContentHtml.get(article.id) || '').split(/\s+/).filter(Boolean).length || undefined,
        timeRequired: article.reading_time_minutes ? `PT${article.reading_time_minutes}M` : undefined,
      })} />
    ))}
  </div>
</BaseLayout>
