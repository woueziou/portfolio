---
import ProjectForm from '@/components/admin/ProjectForm'
import ProjectPublishControls from '@/components/admin/ProjectPublishControls'
import AdminLayout from '@/layouts/AdminLayout.astro'
import { createSupabaseServerClient } from '@/lib/supabase/server'

export const prerender = false

const { id } = Astro.params
const supabase = createSupabaseServerClient(Astro.cookies)

// Get current user
const {
  data: { user },
  error: authError,
} = await supabase.auth.getUser()
if (authError || !user) {
  return Astro.redirect('/admin/login')
}

// Fetch project
const { data: project, error } = await supabase
  .from('projects')
  .select('*')
  .eq('id', id)
  .eq('user_id', user.id)
  .single()

if (error || !project) {
  return Astro.redirect('/admin/projects')
}
---

<AdminLayout title={`Edit: ${project.title}`} activeItem="projects">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-foreground">
          Edit Project
        </h1>
        <p class="mt-1 text-sm text-muted-foreground">
          {project.title}
        </p>
      </div>
      <a
        href="/admin/projects"
        class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted/50 transition-colors"
      >
        Back to Projects
      </a>
    </div>

    {/* Publication Controls */}
    <div class="rounded-xl border border-border bg-card p-6">
      <h2 class="text-lg font-semibold text-foreground mb-4">
        Publication
      </h2>
      <ProjectPublishControls
        client:load
        projectId={project.id}
        projectTitle={project.title}
        currentStatus={project.publication_status}
        publishedAt={project.published_at}
        slug={project.slug}
      />
    </div>

    {/* Project Metadata */}
    <div class="rounded-xl border border-border bg-card p-6">
      <h2 class="text-lg font-semibold text-foreground mb-4">
        Project Metadata
      </h2>
      <ProjectForm
        client:load
        project={project}
        onSuccessPath="/admin/projects"
        onCancelPath="/admin/projects"
      />
    </div>
  </div>
</AdminLayout>
