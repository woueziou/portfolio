---
import AdminLayout from '@/layouts/AdminLayout.astro'
import { createSupabaseServerClient } from '@/lib/supabase/server'

export const prerender = false

const supabase = createSupabaseServerClient(Astro.cookies)

// 🔢 Project counts
const [{ count: totalProjects }, { count: publishedProjects }, { count: draftProjects }] =
  await Promise.all([
    supabase.from('projects').select('*', { count: 'exact', head: true }),
    supabase.from('projects').select('*', { count: 'exact', head: true }).eq('publication_status', 'published'),
    supabase.from('projects').select('*', { count: 'exact', head: true }).eq('publication_status', 'draft'),
  ])

// 📄 Article count
const { count: totalArticles } = await supabase.from('articles').select('*', { count: 'exact', head: true })

// 👁️ Visitor metrics
const today = new Date().toISOString().slice(0, 10)

const { data: todayViews } = await supabase
  .from('page_views')
  .select('count')
  .eq('date', today)

const { data: monthViews } = await supabase
  .from('page_views')
  .select('count')
  .gte('date', new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString().slice(0, 10))

const { data: yearViews } = await supabase
  .from('page_views')
  .select('count')
  .gte('date', new Date(new Date().getFullYear(), 0, 1).toISOString().slice(0, 10))

const todayCount = todayViews?.reduce((sum, r) => sum + (r.count || 0), 0) || 0
const monthCount = monthViews?.reduce((sum, r) => sum + (r.count || 0), 0) || 0
const yearCount = yearViews?.reduce((sum, r) => sum + (r.count || 0), 0) || 0
---

<AdminLayout title="Dashboard">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-foreground">Dashboard</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        Overview of your portfolio content and visitor activity
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">

      <!-- Visitor: Today (large card) -->
      <div class="md:col-span-2 lg:col-span-2 rounded-xl border border-border bg-card p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="rounded-lg bg-blue-50 dark:bg-blue-900/20 p-2.5 text-blue-600 dark:text-blue-400">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <div>
            <span class="text-sm font-medium text-muted-foreground">Visitors Today</span>
            <p class="text-3xl font-bold text-foreground">{todayCount}</p>
          </div>
        </div>
        <div class="flex items-center gap-6 text-sm text-muted-foreground">
          <div>
            <span class="block text-xs uppercase tracking-wider">This Month</span>
            <span class="text-lg font-semibold text-foreground">{monthCount}</span>
          </div>
          <div>
            <span class="block text-xs uppercase tracking-wider">This Year</span>
            <span class="text-lg font-semibold text-foreground">{yearCount}</span>
          </div>
        </div>
      </div>

      <!-- Total Projects -->
      <div class="rounded-xl border border-border bg-card p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-muted-foreground">Total Projects</span>
          <div class="rounded-lg bg-purple-50 dark:bg-purple-900/20 p-2 text-purple-600 dark:text-purple-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-foreground">{totalProjects ?? 0}</p>
      </div>

      <!-- Published Projects -->
      <div class="rounded-xl border border-border bg-card p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-muted-foreground">Published</span>
          <div class="rounded-lg bg-green-50 dark:bg-green-900/20 p-2 text-green-600 dark:text-green-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-foreground">{publishedProjects ?? 0}</p>
      </div>

      <!-- Drafts -->
      <div class="rounded-xl border border-border bg-card p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-muted-foreground">Drafts</span>
          <div class="rounded-lg bg-yellow-50 dark:bg-yellow-900/20 p-2 text-yellow-600 dark:text-yellow-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-foreground">{draftProjects ?? 0}</p>
      </div>

      <!-- Total Articles -->
      <div class="rounded-xl border border-border bg-card p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-muted-foreground">Articles</span>
          <div class="rounded-lg bg-orange-50 dark:bg-orange-900/20 p-2 text-orange-600 dark:text-orange-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-foreground">{totalArticles ?? 0}</p>
      </div>

      <!-- Quick Actions (spans 2 columns) -->
      <div class="md:col-span-2 rounded-xl border border-border bg-card p-6">
        <h2 class="text-lg font-semibold text-foreground mb-4">Quick Actions</h2>
        <div class="flex flex-wrap gap-3">
          <a
            href="/admin/projects/new"
            class="inline-flex items-center gap-2 rounded-lg bg-foreground text-background px-4 py-2.5 text-sm font-medium hover:bg-foreground/90 transition-colors"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Project
          </a>
          <a
            href="/admin/articles/new"
            class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted/50 transition-colors"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Article
          </a>
          <a
            href="/admin/projects"
            class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2.5 text-sm font-medium text-foreground hover:bg-muted/50 transition-colors"
          >
            View All Projects
          </a>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
