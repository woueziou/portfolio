---
import AdminLayout from '@/layouts/AdminLayout.astro'
import { createSupabaseServerClient } from '@/lib/supabase/server'

export const prerender = false

const supabase = createSupabaseServerClient(Astro.cookies)

// Fetch counts for dashboard
const [
  { count: totalProjects },
  { count: publishedProjects },
  { count: draftProjects },
] = await Promise.all([
  supabase.from('projects').select('*', { count: 'exact', head: true }),
  supabase.from('projects').select('*', { count: 'exact', head: true }).eq('publication_status', 'published'),
  supabase.from('projects').select('*', { count: 'exact', head: true }).eq('publication_status', 'draft'),
])

const stats = [
  {
    label: 'Total Projects',
    value: totalProjects ?? 0,
    icon: 'folder',
    color: 'bg-blue-50 text-blue-600 dark:bg-blue-900/20 dark:text-blue-400',
  },
  {
    label: 'Published',
    value: publishedProjects ?? 0,
    icon: 'globe',
    color: 'bg-green-50 text-green-600 dark:bg-green-900/20 dark:text-green-400',
  },
  {
    label: 'Drafts',
    value: draftProjects ?? 0,
    icon: 'edit',
    color: 'bg-yellow-50 text-yellow-600 dark:bg-yellow-900/20 dark:text-yellow-400',
  },
]
---

<AdminLayout title="Dashboard" activeItem="dashboard">
  <div class="space-y-8">
    <div>
      <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">Dashboard</h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
        Overview of your portfolio content
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {stats.map(stat => (
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{stat.label}</span>
            <span class={`rounded-lg p-2 ${stat.color}`}>
              {stat.icon === 'folder' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
              )}
              {stat.icon === 'globe' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              )}
              {stat.icon === 'edit' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              )}
            </span>
          </div>
          <p class="mt-4 text-3xl font-bold text-zinc-900 dark:text-zinc-100">{stat.value}</p>
        </div>
      ))}
    </div>

    <!-- Quick Actions -->
    <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6">
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mb-4">Quick Actions</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="/admin/projects/new"
          class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 dark:bg-zinc-100 px-4 py-2.5 text-sm font-medium text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          New Project
        </a>
        <a
          href="/admin/projects"
          class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 dark:border-zinc-700 px-4 py-2.5 text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
        >
          View All Projects
        </a>
      </div>
    </div>
  </div>
</AdminLayout>
