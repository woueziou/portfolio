---
import { ArrowRight, Eye, FileText, FolderOpen, PenLine, Plus } from 'lucide-react'
import { Button } from '@/components/ui/button'
import AdminLayout from '@/layouts/AdminLayout.astro'
import { createSupabaseServerClient } from '@/lib/supabase/server'

export const prerender = false

const supabase = createSupabaseServerClient(Astro.cookies)

const today = new Date().toISOString().slice(0, 10)
const monthStart = new Date(new Date().getFullYear(), new Date().getMonth(), 1)
  .toISOString()
  .slice(0, 10)

// All five queries are independent — run them in a single round-trip batch.
const [
  [{ count: totalProjects }, { count: publishedProjects }, { count: draftProjects }],
  { count: totalArticles },
  { data: todayViews },
  { data: monthViews },
] = await Promise.all([
  Promise.all([
    supabase.from('projects').select('*', { count: 'exact', head: true }),
    supabase
      .from('projects')
      .select('*', { count: 'exact', head: true })
      .eq('publication_status', 'published'),
    supabase
      .from('projects')
      .select('*', { count: 'exact', head: true })
      .eq('publication_status', 'draft'),
  ]),
  supabase.from('articles').select('*', { count: 'exact', head: true }),
  supabase.from('page_views').select('count').eq('date', today),
  supabase.from('page_views').select('count').gte('date', monthStart),
])

const todayCount = todayViews?.reduce((sum, r) => sum + (r.count || 0), 0) || 0
const monthCount = monthViews?.reduce((sum, r) => sum + (r.count || 0), 0) || 0
---

<AdminLayout title="Dashboard">
  <div class="space-y-8">
    <div>
      <h1 class="text-xl font-semibold text-foreground">Dashboard</h1>
      <p class="mt-0.5 text-sm text-muted-foreground">
        Overview of your portfolio
      </p>
    </div>

    {/* Stats */}
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="bg-muted/50 p-4">
        <div class="flex items-center gap-2 text-muted-foreground mb-2">
          <Eye className="h-4 w-4" />
          <span class="text-xs font-medium">Today</span>
        </div>
        <p class="text-2xl font-semibold text-foreground">{todayCount}</p>
        <p class="text-xs text-muted-foreground mt-1">
          {monthCount} this month
        </p>
      </div>

      <div class="bg-muted/50 p-4">
        <div class="flex items-center gap-2 text-muted-foreground mb-2">
          <FolderOpen className="h-4 w-4" />
          <span class="text-xs font-medium">Projects</span>
        </div>
        <p class="text-2xl font-semibold text-foreground">{totalProjects ?? 0}</p>
        <p class="text-xs text-muted-foreground mt-1">
          {publishedProjects ?? 0} published
        </p>
      </div>

      <div class="bg-muted/50 p-4">
        <div class="flex items-center gap-2 text-muted-foreground mb-2">
          <PenLine className="h-4 w-4" />
          <span class="text-xs font-medium">Drafts</span>
        </div>
        <p class="text-2xl font-semibold text-foreground">{draftProjects ?? 0}</p>
      </div>

      <div class="bg-muted/50 p-4">
        <div class="flex items-center gap-2 text-muted-foreground mb-2">
          <FileText className="h-4 w-4" />
          <span class="text-xs font-medium">Articles</span>
        </div>
        <p class="text-2xl font-semibold text-foreground">{totalArticles ?? 0}</p>
      </div>
    </div>

    {/* Quick Actions */}
    <div class="space-y-3">
      <h2 class="text-sm font-medium text-muted-foreground">Quick Actions</h2>
      <div class="flex flex-wrap gap-2">
        <Button variant="ghost" size="sm" asChild>
          <a href="/admin/projects/new">
            <Plus className="h-4 w-4 mr-1.5" />
            New Project
          </a>
        </Button>
        <Button variant="ghost" size="sm" asChild>
          <a href="/admin/articles/new">
            <Plus className="h-4 w-4 mr-1.5" />
            New Article
          </a>
        </Button>
        <Button variant="ghost" size="sm" asChild>
          <a href="/admin/projects">
            View Projects
            <ArrowRight className="h-4 w-4 ml-1.5" />
          </a>
        </Button>
      </div>
    </div>
  </div>
</AdminLayout>
