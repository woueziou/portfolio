---
import { Plus } from 'lucide-react'
import { ArticleList } from '@/components/admin/ArticleList'
import { Button } from '@/components/ui/button'
import AdminLayout from '@/layouts/AdminLayout.astro'
---

<AdminLayout title="Articles" activeItem="articles">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-semibold text-foreground">Articles</h1>
        <p class="mt-0.5 text-sm text-muted-foreground">
          Manage your blog articles and project documentation
        </p>
      </div>
      <Button size="sm" className="whitespace-nowrap" asChild>
        <a href="/admin/articles/new" class="flex items-center">
          <Plus className="h-4 w-4 mr-1.5 shrink-0" />
          <span>New Article</span>
        </a>
      </Button>
    </div>

    <ArticleList client:load initialData={{ articles: [], total: 0, page: 1, perPage: 12, totalPages: 0 }} />
  </div>
</AdminLayout>
