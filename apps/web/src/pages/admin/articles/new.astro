---
import ArticleEditorIsland from '@/components/admin/editor/ArticleEditorIsland'
import AdminLayout from '@/layouts/AdminLayout.astro'
---

<AdminLayout title="New Article" activeItem="articles">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-semibold text-foreground">New Article</h1>
        <p class="mt-0.5 text-sm text-muted-foreground">
          Start writing — save to set a title and slug
        </p>
      </div>
      <a
        href="/admin/articles"
        class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-muted/50 transition-colors"
      >
        Back to Articles
      </a>
    </div>

    <ArticleEditorIsland client:load />
  </div>
</AdminLayout>
