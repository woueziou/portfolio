---
import ProfileForm from '@/components/admin/ProfileForm'
import AdminLayout from '@/layouts/AdminLayout.astro'

export const prerender = false

// Middleware has already authenticated the request and injected user + supabase client.
const { user, supabase } = Astro.locals

const [{ data: profile }, { data: config }] = await Promise.all([
  supabase
    .from('profiles')
    .select('*')
    .eq('id', user?.id || '')
    .single(),
  supabase
    .from('site_config')
    .select('social_links')
    .eq('id', 1)
    .single(),
])

const socialLinks = (config?.social_links || {}) as Record<string, string>
---

<AdminLayout title="Profile" activeItem="me">
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="text-xl font-semibold text-foreground">Profile</h1>
      <p class="mt-0.5 text-sm text-muted-foreground">
        Manage your personal information displayed on the home page
      </p>
    </div>

    <ProfileForm
      client:load
      profile={profile || {
        id: user?.id || '',
        first_name: '',
        last_name: '',
        title: '',
        description: '',
        avatar_url: '',
        username: '',
        socials: {},
      }}
      socialLinks={socialLinks}
    />
  </div>
</AdminLayout>
