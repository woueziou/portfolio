---
import AdminLayout from '@/layouts/AdminLayout.astro'
import { createSupabaseServerClient } from '@/lib/supabase/server'

export const prerender = false

const supabase = createSupabaseServerClient(Astro.cookies)

const {
  data: { user },
} = await supabase.auth.getUser()

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user?.id || '')
  .single()
---

<AdminLayout title="Profile" activeItem="me">
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">Profile</h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
        Manage your personal information and public profile
      </p>
    </div>

    <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-6">
      <form id="profile-form" class="space-y-5">
        <input type="hidden" name="action" value="updateProfile" />

        <!-- Avatar -->
        <div class="flex items-center gap-4">
          <div class="h-16 w-16 rounded-full bg-zinc-200 dark:bg-zinc-700 flex items-center justify-center text-xl font-bold text-zinc-600 dark:text-zinc-300">
            {profile?.first_name?.charAt(0)?.toUpperCase() || 'A'}
          </div>
          <div>
            <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">Avatar</p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">Upload a photo via the avatar URL field</p>
          </div>
        </div>

        <!-- Name fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="first_name" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">
              First Name
            </label>
            <input
              id="first_name"
              name="first_name"
              type="text"
              value={profile?.first_name || ''}
              required
              class="w-full rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 px-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-500 dark:focus:ring-zinc-400"
            />
          </div>
          <div>
            <label for="last_name" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">
              Last Name
            </label>
            <input
              id="last_name"
              name="last_name"
              type="text"
              value={profile?.last_name || ''}
              required
              class="w-full rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 px-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-500 dark:focus:ring-zinc-400"
            />
          </div>
        </div>

        <!-- Title -->
        <div>
          <label for="title" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">
            Professional Title
          </label>
          <input
            id="title"
            name="title"
            type="text"
            value={profile?.title || ''}
            placeholder="e.g., Full-stack Developer"
            class="w-full rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 px-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-500 dark:focus:ring-zinc-400"
          />
        </div>

        <!-- Description -->
        <div>
          <label for="description" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">
            Bio / Description
          </label>
          <textarea
            id="description"
            name="description"
            rows={4}
            placeholder="Tell visitors about yourself..."
            class="w-full rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 px-3 py-2 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-500 dark:focus:ring-zinc-400"
          >{profile?.description || ''}</textarea>
        </div>

        <!-- Username (read-only) -->
        <div>
          <label for="username" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">
            Username
          </label>
          <input
            id="username"
            type="text"
            value={profile?.username || ''}
            disabled
            class="w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/50 px-3 py-2 text-sm text-zinc-500 dark:text-zinc-400 cursor-not-allowed"
          />
          <p class="mt-1 text-xs text-zinc-400">Username cannot be changed</p>
        </div>

        <!-- Email (read-only) -->
        <div>
          <label for="email" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">
            Email
          </label>
          <input
            id="email"
            type="email"
            value={user?.email || ''}
            disabled
            class="w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/50 px-3 py-2 text-sm text-zinc-500 dark:text-zinc-400 cursor-not-allowed"
          />
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3 pt-2">
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 dark:bg-zinc-100 px-4 py-2.5 text-sm font-medium text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors disabled:opacity-50"
          >
            Save Changes
          </button>
          <span id="profile-status" class="text-sm text-zinc-500"></span>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('profile-form') as HTMLFormElement
  const status = document.getElementById('profile-status')!

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement
    btn.disabled = true
    status.textContent = 'Saving...'

    const formData = new FormData(form)
    const data = Object.fromEntries(formData.entries())

    try {
      const { error } = await (window as any).Astro.actions.profiles.update(data)
      if (error) {
        status.textContent = `Error: ${error.message}`
        status.className = 'text-sm text-red-500'
      } else {
        status.textContent = 'Saved successfully!'
        status.className = 'text-sm text-green-500'
      }
    } catch (err: any) {
      status.textContent = `Error: ${err.message || 'Unknown error'}`
      status.className = 'text-sm text-red-500'
    } finally {
      btn.disabled = false
      setTimeout(() => { status.textContent = '' }, 3000)
    }
  })
</script>
