---
import { Github, Globe, Link2, LinkedinIcon, Save, X } from 'lucide-react'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Textarea } from '@/components/ui/textarea'
import AdminLayout from '@/layouts/AdminLayout.astro'
import { createSupabaseServerClient } from '@/lib/supabase/server'

export const prerender = false

const supabase = createSupabaseServerClient(Astro.cookies)

const { data: config } = await supabase.from('site_config').select('*').eq('id', 1).single()

const socialLinks = (config?.social_links || {}) as Record<string, string>
---

<AdminLayout title="Settings" activeItem="settings">
  <div class="max-w-2xl mx-auto space-y-8">
    <div>
      <h1 class="text-xl font-semibold text-foreground">Settings</h1>
      <p class="mt-0.5 text-sm text-muted-foreground">
        Configure your site metadata and social links
      </p>
    </div>

    <!-- Site Info -->
    <section class="space-y-6">
      <div class="flex items-center gap-2 text-sm font-medium text-muted-foreground">
        <Globe className="h-4 w-4" />
        Site Information
      </div>

      <form id="settings-form" class="space-y-4">
        <!-- Site Title -->
        <div class="space-y-2">
          <Label htmlFor="site_title">Site Title</Label>
          <Input
            id="site_title"
            name="site_title"
            type="text"
            value={config?.site_title || 'Portfolio'}
            required
            className="border-0 bg-muted/50"
          />
        </div>

        <!-- Site Tagline -->
        <div class="space-y-2">
          <Label htmlFor="site_tagline">Tagline</Label>
          <Input
            id="site_tagline"
            name="site_tagline"
            type="text"
            value={config?.site_tagline || ''}
            placeholder="A short description of your site"
            className="border-0 bg-muted/50"
          />
        </div>

        <!-- SEO Description -->
        <div class="space-y-2">
          <Label htmlFor="seo_description">SEO Description</Label>
          <Textarea
            id="seo_description"
            name="seo_description"
            rows={3}
            placeholder="Meta description for search engines"
            className="border-0 bg-muted/50 resize-none"
          >{config?.seo_description || ''}</Textarea>
        </div>

        <!-- OG Image -->
        <div class="space-y-2">
          <Label htmlFor="seo_og_image">Open Graph Image URL</Label>
          <Input
            id="seo_og_image"
            name="seo_og_image"
            type="url"
            value={config?.seo_og_image || ''}
            placeholder="https://example.com/og-image.png"
            className="border-0 bg-muted/50"
          />
        </div>

        <div class="flex items-center gap-3 pt-2">
          <Button type="submit" size="sm">
            <Save className="h-4 w-4 mr-1.5" />
            Save Site Info
          </Button>
          <span id="settings-status" class="text-sm text-muted-foreground"></span>
        </div>
      </form>
    </section>

    <!-- Social Links -->
    <section class="space-y-6">
      <div class="flex items-center gap-2 text-sm font-medium text-muted-foreground">
        <Link2 className="h-4 w-4" />
        Social Links
      </div>

      <form id="social-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-2">
            <Label htmlFor="social_github" className="flex items-center gap-1.5">
              <Github className="h-3.5 w-3.5" />
              GitHub
            </Label>
            <Input
              id="social_github"
              type="url"
              value={socialLinks.github || ''}
              placeholder="https://github.com/username"
              className="border-0 bg-muted/50"
            />
          </div>
          <div class="space-y-2">
            <Label htmlFor="social_twitter" className="flex items-center gap-1.5">
              <X className="h-3.5 w-3.5" />
              Twitter / X
            </Label>
            <Input
              id="social_twitter"
              type="url"
              value={socialLinks.twitter || ''}
              placeholder="https://twitter.com/username"
              className="border-0 bg-muted/50"
            />
          </div>
          <div class="space-y-2">
            <Label htmlFor="social_linkedin" className="flex items-center gap-1.5">
              <LinkedinIcon className="h-3.5 w-3.5" />
              LinkedIn
            </Label>
            <Input
              id="social_linkedin"
              type="url"
              value={socialLinks.linkedin || ''}
              placeholder="https://linkedin.com/in/username"
              className="border-0 bg-muted/50"
            />
          </div>
          <div class="space-y-2">
            <Label htmlFor="social_website" className="flex items-center gap-1.5">
              <Globe className="h-3.5 w-3.5" />
              Website
            </Label>
            <Input
              id="social_website"
              type="url"
              value={socialLinks.website || ''}
              placeholder="https://example.com"
              className="border-0 bg-muted/50"
            />
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <Button type="submit" size="sm">
            <Save className="h-4 w-4 mr-1.5" />
            Save Social Links
          </Button>
          <span id="social-status" class="text-sm text-muted-foreground"></span>
        </div>
      </form>
    </section>
  </div>
</AdminLayout>

<script>
  // Site Info form
  const settingsForm = document.getElementById('settings-form') as HTMLFormElement
  const settingsStatus = document.getElementById('settings-status')!

  settingsForm.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = settingsForm.querySelector('button[type="submit"]') as HTMLButtonElement
    btn.disabled = true
    settingsStatus.textContent = 'Saving...'

    const formData = new FormData(settingsForm)
    const data: Record<string, any> = {}
    formData.forEach((val, key) => { data[key] = val })

    // Strip empty strings to null
    for (const key of ['site_tagline', 'seo_description', 'seo_og_image']) {
      if (!data[key]) data[key] = null
    }

    try {
      const { error } = await (window as any).Astro.actions.siteConfig.update(data)
      if (error) {
        settingsStatus.textContent = `Error: ${error.message}`
        settingsStatus.className = 'text-sm text-red-500'
      } else {
        settingsStatus.textContent = 'Saved successfully!'
        settingsStatus.className = 'text-sm text-green-500'
      }
    } catch (err: any) {
      settingsStatus.textContent = `Error: ${err.message || 'Unknown error'}`
      settingsStatus.className = 'text-sm text-red-500'
    } finally {
      btn.disabled = false
      setTimeout(() => { settingsStatus.textContent = '' }, 3000)
    }
  })

  // Social Links form
  const socialForm = document.getElementById('social-form') as HTMLFormElement
  const socialStatus = document.getElementById('social-status')!

  socialForm.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = socialForm.querySelector('button[type="submit"]') as HTMLButtonElement
    btn.disabled = true
    socialStatus.textContent = 'Saving...'

    const socials: Record<string, string> = {}
    const fields = ['github', 'twitter', 'linkedin', 'website']
    for (const field of fields) {
      const val = (document.getElementById(`social_${field}`) as HTMLInputElement).value.trim()
      if (val) socials[field] = val
    }

    try {
      const { error } = await (window as any).Astro.actions.siteConfig.update({ social_links: socials })
      if (error) {
        socialStatus.textContent = `Error: ${error.message}`
        socialStatus.className = 'text-sm text-red-500'
      } else {
        socialStatus.textContent = 'Saved successfully!'
        socialStatus.className = 'text-sm text-green-500'
      }
    } catch (err: any) {
      socialStatus.textContent = `Error: ${err.message || 'Unknown error'}`
      socialStatus.className = 'text-sm text-red-500'
    } finally {
      btn.disabled = false
      setTimeout(() => { socialStatus.textContent = '' }, 3000)
    }
  })
</script>
