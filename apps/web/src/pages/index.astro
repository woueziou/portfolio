---
import type { Database } from '@repo/shared'
import { supabase } from '@repo/shared'
import Footer from '@/components/home/footer/footer'
import Hero from '@/components/home/hero/hero'
import ProjectClient from '@/components/home/projects/project-client'
import { ToastContainer } from '@/components/ui/toast'
import ThemeSwitcher from '@/components/ThemeSwitcher'
import BaseLayout from '../layouts/BaseLayout.astro'

export const prerender = true

type Project = Database['public']['Tables']['projects']['Row']

const { data: projects, error } = await supabase
  .from('projects')
  .select()
  .order('project_date', { ascending: false })

const typedProjects: Project[] = !error && projects ? (projects as Project[]) : []
const fetchError = error?.message ?? null
---

<BaseLayout title="Taas S. Ekpaye — Software Developer">
  <div class="antialiased bg-[url('/noise-bg.png')] font-baufra min-h-screen flex flex-col justify-between">
    <!-- Top bar: nav links + theme switcher -->
    <div id="topbar" class="fixed top-0 left-0 right-0 z-50 flex items-center justify-center px-4 py-3 transition-all duration-200">
      <nav class="flex items-center gap-6 text-sm font-medium">
        <a href="/#hero" class="text-muted-foreground hover:text-foreground transition-colors">
          Home
        </a>
        <a href="/#projects" class="text-muted-foreground hover:text-foreground transition-colors">
          Projects
        </a>
        <a href="/blogs" class="text-muted-foreground hover:text-foreground transition-colors">
          Blogs
        </a>
      </nav>
      <div class="absolute right-4 top-1/2 -translate-y-1/2">
        <ThemeSwitcher client:load />
      </div>
    </div>

    <script>
      const topbar = document.getElementById('topbar')
      let ticking = false

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const scrolled = window.scrollY > 20
            topbar?.classList.toggle('bg-background/60', scrolled)
            topbar?.classList.toggle('backdrop-blur-sm', scrolled)
            ticking = false
          })
          ticking = true
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true })
    </script>

    <div class="flex-grow">
      <div class="flex flex-col items-center justify-center min-h-screen">
        <section id="hero">
          <Hero client:load />
        </section>

        <section
          id="projects"
          class="grid w-full grid-cols-1 container mx-auto place-items-center pt-8 gap-y-10 scroll-mt-20"
        >
          <h1 class="text-2xl font-bold uppercase underline underline-offset-8">Projects</h1>
          {
            fetchError ? (
              <p class="text-sm text-muted-foreground text-center px-4">
                Projects are currently unavailable. Please check back later.
              </p>
            ) : typedProjects.length === 0 ? (
              <p class="text-sm text-muted-foreground">No projects yet.</p>
            ) : (
              <ProjectClient data={typedProjects} client:load />
            )
          }
        </section>

        <section class="w-full">
          <Footer client:load />
        </section>
      </div>
    </div>
    <ToastContainer client:load />
  </div>
</BaseLayout>
