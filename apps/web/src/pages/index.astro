---
import type { Database } from '@repo/shared'
import { supabase } from '@repo/shared'
import Footer from '@/components/home/footer/footer'
import Hero from '@/components/home/hero/hero'
import ProjectClient from '@/components/home/projects/project-client'
import ThemeSwitcher from '@/components/ThemeSwitcher'
import BaseLayout from '../layouts/BaseLayout.astro'

export const prerender = true

type Project = Database['public']['Tables']['projects']['Row']

const { data: projects, error } = await supabase
  .from('projects')
  .select()
  .order('project_date', { ascending: false })

const typedProjects: Project[] = !error && projects ? (projects as Project[]) : []
const fetchError = error?.message ?? null
---

<BaseLayout title="Taas S. Ekpaye — Software Developer">
  <div class="antialiased bg-[url('/noise-bg.png')] font-baufra min-h-screen flex flex-col justify-between">
    <div class="fixed top-4 right-4 z-50">
      <ThemeSwitcher client:load />
    </div>
    <div class="flex-grow">
      <div class="flex flex-col items-center justify-center min-h-screen">
        <Hero client:load />
        <div class="grid w-full grid-cols-1 container mx-auto place-items-center pt-8 gap-y-10">
          <h1 class="text-2xl font-bold uppercase underline underline-offset-8">Projects</h1>
          {
            fetchError ? (
              <p class="text-sm text-muted-foreground text-center px-4">
                Projects are currently unavailable. Please check back later.
              </p>
            ) : typedProjects.length === 0 ? (
              <p class="text-sm text-muted-foreground">No projects yet.</p>
            ) : (
              <ProjectClient data={typedProjects} client:load />
            )
          }
        </div>
      </div>
    </div>
    <Footer client:load />
  </div>
</BaseLayout>
