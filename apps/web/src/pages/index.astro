---
import HomeContent from '@/components/home/HomeContent'
import Footer from '@/components/home/footer/footer.astro'
import ThemeSwitcher from '@/components/ThemeSwitcher'
import { ToastContainer } from '@/components/ui/toast'
import BaseLayout from '../layouts/BaseLayout.astro'

// Rendered on demand so the share image (og:image) reflects the admin settings
// without a rebuild; the CDN caches the page for 5 minutes.
export const prerender = false
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400')
---

<BaseLayout title="Taas S. Ekpaye — Full Stack Engineer">
  <div class="antialiased bg-noise font-baufra min-h-screen flex flex-col justify-between">
    <!-- Top bar -->
    <div id="topbar" data-astro-transition-persist="topbar" class="fixed top-0 left-0 right-0 z-50 flex items-center justify-center px-4 py-3 transition-all duration-200">
      <div class="absolute right-4 top-4 -translate-y-1/2">
        <ThemeSwitcher client:load />
      </div>
    </div>

    <script>
      const topbar = document.getElementById('topbar')
      let ticking = false
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const scrolled = window.scrollY > 20
            topbar?.classList.toggle('bg-background/60', scrolled)
            topbar?.classList.toggle('backdrop-blur-sm', scrolled)
            ticking = false
          })
          ticking = true
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true })
    </script>

    <div class="flex-grow">
      <div class="flex flex-col items-stretch min-h-screen">
        <HomeContent client:visible />

        <section class="w-full">
          <Footer />
        </section>
      </div>
    </div>
    <ToastContainer client:load />
  </div>
</BaseLayout>
