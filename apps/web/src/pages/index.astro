---
import ContentTabs from '@/components/home/content-tabs'
import Footer from '@/components/home/footer/footer.astro'
import GitHubCalendarIsland from '@/components/home/hero/GitHubCalendarIsland'
import HeroStatic from '@/components/home/hero/hero-static.astro'
import ThemeSwitcher from '@/components/ThemeSwitcher'
import { ToastContainer } from '@/components/ui/toast'
import { experience } from '@/data/experience'
import { getHomeData } from '@/lib/build-data'
import BaseLayout from '../layouts/BaseLayout.astro'

// Read at build time: the page ships as complete HTML. A rebuild is triggered
// by the Supabase content triggers (see the README, "Reconstruction automatique").
const { profile, socialLinks, projects, articles } = await getHomeData()
---

<BaseLayout title="Taas S. Ekpaye — Full Stack Engineer">
  <div class="antialiased bg-noise font-baufra min-h-screen flex flex-col justify-between">
    <!-- Theme button: top right of the page, scrolls away with it -->
    <div id="topbar" data-astro-transition-persist="topbar" class="absolute top-2 right-3 sm:right-4 z-50">
      <ThemeSwitcher client:load />
    </div>

    <div class="flex-grow">
      <div class="flex flex-col items-stretch min-h-screen">
        <section id="hero">
          <HeroStatic profile={profile} socialLinks={socialLinks} />
          <GitHubCalendarIsland client:visible />
        </section>

        <section
          id="projects"
          class="w-full px-4 sm:px-6 md:px-8 lg:px-12 mx-auto max-w-7xl pt-16 pb-8 scroll-mt-20"
        >
          <ContentTabs client:load projects={projects} articles={articles} experience={experience} />
        </section>

        <section class="w-full">
          <Footer />
        </section>
      </div>
    </div>
    <ToastContainer client:idle />
  </div>
</BaseLayout>
