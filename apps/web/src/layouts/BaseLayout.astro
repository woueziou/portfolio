---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const {
  title,
  description = 'Full Stack Engineer — 6+ years building web & mobile applications for airline enterprise.',
  ogImage = '/og-default.svg',
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="192x192" href="/logo192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/logo512.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Baufra Font -->
    <link rel="stylesheet" href="/baufra/stylesheet.css" />

    <!-- JSON-LD Person Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Taas S. Ekpaye',
        url: 'https://taas-s-ekpaye.vercel.app',
        sameAs: [
          'https://github.com/woueziou',
          'https://www.linkedin.com/in/taas-ekpaye/',
          'https://medium.com/@taasekpaye',
        ],
        jobTitle: 'Full Stack Engineer',
      })}
    />

    <!-- Theme initializer (runs before first paint — no FOUC) -->
    <script is:inline>
      function getTheme() {
        const stored = localStorage.getItem('theme')
        if (stored === 'dark' || stored === 'light') return stored
        return window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light'
      }

      // Apply theme immediately
      document.documentElement.classList.toggle('dark', getTheme() === 'dark')

      // Re-apply theme after Astro view transitions
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.toggle('dark', getTheme() === 'dark')
      })
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <!-- SVG noise filters (referenced by .bg-noise via filter: url(#noise-*) ) -->
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <!-- Light mode: warm brown noise tinted to theme -->
      <filter id="noise-light">
        <feTurbulence type="fractalNoise" baseFrequency=".4" numOctaves="3" result="noise" />
        <feColorMatrix type="matrix" values="0 0 0 0 0.15   0 0 0 0 0.13   0 0 0 0 0.10   0.20 0 0 0 0" />
      </filter>
      <!-- Dark mode: warm beige noise tinted to theme -->
      <filter id="noise-dark">
        <feTurbulence type="fractalNoise" baseFrequency=".4" numOctaves="3" result="noise" />
        <feColorMatrix type="matrix" values="0 0 0 0 0.92   0 0 0 0 0.88   0 0 0 0 0.78   0.06 0 0 0 0" />
      </filter>
    </svg>
    <slot />
  </body>
</html>
