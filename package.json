{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter web dev",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run lint && bun run typecheck && bun run --filter web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@vitest/coverage-v8": "^4.1.8",
    "vitest": "^4.1.8",
    "web": "workspace:*"
  }
}
