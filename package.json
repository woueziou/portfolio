{
  "name": "portfolio",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@portfolio/web",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build --filter=@portfolio/web",
    "test": "turbo run test",
    "deploy": "bash scripts/deploy-local.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@vitest/coverage-v8": "^4.1.8",
    "turbo": "^2.9.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {}
}
