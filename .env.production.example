# ============================================================
# Production Supabase credentials — copy to .env.production
# ============================================================
# Get these values from:
#   Supabase Dashboard → Project Settings → API
#   Supabase Dashboard → Project Settings → Database
# ============================================================

# Server-side Supabase URL & anon key
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Client-side (exposed to browser — same as above for Supabase projects)
PUBLIC_SUPABASE_URL="${SUPABASE_URL}"
PUBLIC_SUPABASE_ANON_KEY="${SUPABASE_ANON_KEY}"

# Database password — from Project Settings → Database → Connection string
SUPABASE_DB_PASSWORD="your-database-password"

# Project reference ID — from `supabase projects list` or Dashboard URL
SUPABASE_PROJECT_ID="kfbzgkjffmfzjzbxoqvr"
